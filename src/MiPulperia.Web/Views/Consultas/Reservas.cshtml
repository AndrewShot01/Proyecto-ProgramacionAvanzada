@model ConsultaReservas
@{ ViewData["Title"] = "Reservas"; }
<div class="page-heading"><div><p class="eyebrow">CONSULTAS</p><h1>Reservas del barrio</h1><p>Historial de reservas, de la más reciente a la más antigua. Horario de Costa Rica.</p></div><a class="button" asp-controller="Procesos" asp-action="Reserva">+ Nueva reserva</a></div>
<form method="get" class="search-form search-bar"><input name="q" value="@Model.Busqueda" placeholder="Buscar cliente..." aria-label="Buscar cliente" /><button class="button secondary">Buscar</button></form>
<partial name="_ReservasSucursales" model="Model.Sucursales" />
