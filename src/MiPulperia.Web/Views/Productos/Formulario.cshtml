@model Producto
@{ var detalle = ViewData["Accion"]?.ToString() == "Detalle"; }
<a class="back-link" asp-action="Index">← Volver al listado</a>
<div class="page-heading"><div><p class="eyebrow">CATÁLOGOS DEL BARRIO</p><h1>@ViewData["Accion"] registro</h1><p class="muted">@ViewData["Catalogo"] · Los campos son obligatorios.</p></div></div>
<section class="panel form-panel"><form method="post" data-maintenance><input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" /><div asp-validation-summary="All" class="validation" role="alert"></div><fieldset disabled="@detalle"><div class="form-grid">
<div class="field"><label asp-for="Nombre"></label><input asp-for="Nombre" type="text"  /><span asp-validation-for="Nombre"></span></div>
<div class="field"><label asp-for="Codigo"></label><input asp-for="Codigo" type="text"  /><span asp-validation-for="Codigo"></span></div>
<div class="field"><label asp-for="Precio"></label><input asp-for="Precio" type="number" step="0.01" min="0.01" /><span asp-validation-for="Precio"></span></div>
<div class="field"><label asp-for="MaximoReserva"></label><input asp-for="MaximoReserva" type="number" min="1" /><span asp-validation-for="MaximoReserva"></span></div>
<div class="field"><label asp-for="HorasReserva"></label><input asp-for="HorasReserva" type="number" min="0.000001" step="0.000001" /><span asp-validation-for="HorasReserva"></span></div>
<div class="field"><label asp-for="ExistenciaMinima"></label><input asp-for="ExistenciaMinima" type="number" min="0" /><span asp-validation-for="ExistenciaMinima"></span></div>
<div class="field full"><label asp-for="Atributos"></label><textarea asp-for="Atributos" spellcheck="false"></textarea><span asp-validation-for="Atributos"></span><p class="hint">Agrega características propias del producto. Ejemplo: {"talla":38,"color":"azul"}.</p><span id="json-status" class="json-status" aria-live="polite"></span><pre id="json-preview" class="json-preview"></pre></div></div></fieldset><div class="form-actions">@if (!detalle) { <button class="button" type="submit">Guardar registro</button> } else { <a class="button" asp-action="Edit" asp-route-id="@Model.Id">Editar registro</a> }<a class="button secondary" asp-action="Index">Volver al listado</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
