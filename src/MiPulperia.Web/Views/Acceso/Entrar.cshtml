@model MiPulperia.Web.Controllers.AccesoFormulario
@{ Layout = null; }
<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Ingresar · Mi Pulpería de Barrio</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body><main class="login-shell"><p class="eyebrow">MI PULPERÍA DE BARRIO</p><h1>Bienvenido de nuevo.</h1>
<p class="muted">Ingresa para administrar las tiendas y sus reservas.</p>
<form asp-action="Entrar" method="post" class="form-card">
<div asp-validation-summary="All" class="validation" role="alert"></div>
<input asp-for="ReturnUrl" type="hidden" />
<label asp-for="Usuario"></label><input asp-for="Usuario" autocomplete="username" required />
<label asp-for="Clave">Contraseña</label><input asp-for="Clave" autocomplete="current-password" required />
<button class="button" type="submit">Ingresar</button>
</form></main></body></html>
