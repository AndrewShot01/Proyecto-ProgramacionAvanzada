@model EliminarCatalogo
@{ ViewData["Title"] = "Eliminar registro"; }
<a class="back-link" asp-action="Index">← Volver al listado</a><div class="page-heading"><div><p class="eyebrow">MANTENIMIENTO</p><h1>Eliminar registro</h1></div></div>
<section class="panel form-panel"><h2>@Model.Nombre</h2><p>Se eliminará este registro. Si tiene inventario o reservas relacionados, se conservará para proteger el historial.</p><form method="post" asp-action="Delete" asp-route-id="@Model.Id"><input type="hidden" name="version" value="@Model.Version" /><div asp-validation-summary="All" class="validation" role="alert"></div><div class="form-actions"><button class="button danger" type="submit">Eliminar registro</button><a class="button secondary" asp-action="Index">Cancelar</a></div></form></section>
